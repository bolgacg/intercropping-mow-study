diff --git a/crop_model/test_crop_model_provider.py b/crop_model/test_crop_model_provider.py
index f5c50f6..0c3627a 100644
--- a/crop_model/test_crop_model_provider.py
+++ b/crop_model/test_crop_model_provider.py
@@ -208,3 +208,31 @@ def main():
 
 if __name__ == "__main__":
     raise SystemExit(main())
+
+
+def test_mow_criteria_overrides():
+    """The three criterion keywords default to the module constants, and when
+    passed they reach the decision and the per-day criteria payload."""
+    import json
+    import mow_decision as md
+
+    w = synthetic_weather()
+    physics = sim.run_treatment_physics("spring wheat", w)
+    default = md.apply_mow_decision(physics, 0.25)
+    explicit = md.apply_mow_decision(
+        physics, 0.25,
+        min_height_cm=md.MIN_MOW_HEIGHT_CM,
+        min_interval_days=md.MIN_MOW_INTERVAL_DAYS,
+        critical_comp_index=md.CRITICAL_COMP_INDEX,
+    )
+    assert json.dumps(default, sort_keys=True) == json.dumps(explicit, sort_keys=True)
+
+    taller = md.apply_mow_decision(physics, 0.25, min_height_cm=md.MIN_MOW_HEIGHT_CM + 10)
+    assert all(d["criteria"]["heightThresholdCm"] == md.MIN_MOW_HEIGHT_CM + 10
+               for d in taller["timeseries"])
+    assert taller["mowDates"] != default["mowDates"]
+
+    via_sim = sim.run_treatment_simulation(
+        "spring wheat", w, mow_threshold=0.25,
+        mow_params={"min_height_cm": md.MIN_MOW_HEIGHT_CM + 10})
+    assert json.dumps(via_sim, sort_keys=True) == json.dumps(taller, sort_keys=True)
